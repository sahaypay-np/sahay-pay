# Sahay Pay — environment variables (names only; never commit real values)
# Copy to .env and fill in. .env is gitignored.

# Postgres connection string (production). When unset, the server uses a local
# SQLite file at data/sahay-pay.db (Node 24 built-in node:sqlite).
DATABASE_URL=

# Long random secret used to sign/derive session material and (as fallback) the
# payout-encryption key. REQUIRED in production; generate with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# 32-byte key for AES-256-GCM encryption of payout accounts.
# Base64 or hex of 32 bytes. If unset, a key is derived from SESSION_SECRET.
# If both are unset, an ephemeral key is generated at startup (payout accounts
# become unreadable after restart) and a loud warning is logged.
PAYOUT_ENCRYPTION_KEY=

# Optional extra gate for the one-time admin PIN setup endpoint. When set, the
# setup-pin request must also carry this token. Leave unset to allow first-run
# setup without a token (setup is only possible while no PIN exists).
ADMIN_SETUP_TOKEN=

# Secret for the Muse owner-approval bridge (X-Sahay-Bridge-Secret header).
# When unset, the bridge endpoint is disabled (503).
CLAUDE_APPROVAL_BRIDGE_SECRET=

# Optional webhook URL the server POSTs each new owner review packet to
# (fire-and-forget). When unset, packets simply wait in the admin queue.
OWNER_NOTIFICATION_WEBHOOK_URL=

# Public base URL of the deployed app (used in share links / webhooks).
APP_BASE_URL=

# Server port (default 3000). NODE_ENV=production enables Secure cookies.
PORT=
NODE_ENV=

# --- Not yet configured (Demo Mode: no real payment integration) ---
# Gateway keys for Sahay Pay's OWN charges only (Brand Connect / future fee).
# Gifts NEVER route through a gateway — they move supporter -> recipient
# directly in the supporter's own payment app.
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
INDIA_GATEWAY_KEY_ID=
INDIA_GATEWAY_KEY_SECRET=

# --- Future: object storage for uploads (local disk is used today) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Future: human check before payout reveal ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
