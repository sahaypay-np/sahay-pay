#!/bin/bash
# .githooks/pre-commit — block commits that look like they contain secrets
# (Phase 2 item 892). Install with: ./scripts/install-hooks.sh
#
# Runs the repo's secret scan (scripts/check-secrets.sh) plus a scan of
# the STAGED diff, so a secret is caught before it is ever committed.
# This is a tripwire, not a guarantee — CI runs the same scan on push.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -x scripts/check-secrets.sh ]; then
  if ! scripts/check-secrets.sh > /tmp/sp-precommit-secrets.log 2>&1; then
    echo "pre-commit: secret scan FAILED — commit blocked."
    cat /tmp/sp-precommit-secrets.log
    echo "Remove the secret, rotate it, and try again."
    exit 1
  fi
fi

# Staged-diff scan: same patterns as check-secrets.sh, applied to what is
# about to be committed (added lines only).
PATS='sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|BEGIN .*PRIV''ATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|SESSION_SECRET=[^$< "]{16,}|PAYOUT_ENCRYPTION_KEY=[^$< "]{16,}|postgres://[^ /]*:[^ /]*@'
ALLOW='user:pass@|example\.com|example-|changeme|YOUR_|<[^>]*>|test-bridge-secret|\$\(|placeholder|docs/|README\.md|ARCHITECTURE\.md'
HITS=$(git diff --cached -U0 | grep -E '^\+[^+]' | grep -E "$PATS" | grep -vE "$ALLOW" || true)
if [ -n "$HITS" ]; then
  echo "pre-commit: possible secret in staged changes — commit blocked."
  echo "$HITS" | sed 's/\(.\{60\}\).*/\1... [redacted]/'
  echo "Remove the secret, rotate it, and try again."
  exit 1
fi
exit 0
